# MongoDB Atlas - chuỗi kết nối database (bắt buộc, cần Atlas Vector Search index "vector_index")
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<app>

# Khóa bí mật ký JWT (đặt chuỗi ngẫu nhiên dài, khó đoán)
SECRET_KEY=<random_long_secret>

# Cloudinary (nếu dùng cho upload ảnh)
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# Email SMTP (gửi mail quên mật khẩu, v.v.)
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=<your_email@gmail.com>
MAIL_PASSWORD=<app_password>
MAIL_ENCRYPTION=TLS
MAIL_FROM_ADDRESS=<from_email@gmail.com>
MAIL_FROM_NAME=DataHub

# URL frontend (CORS, link trong email)
CLIENT_URL=http://localhost:3000

# Cloudflare R2 - lưu trữ file
R2_ACCESS_KEY_ID=<r2_access_key_id>
R2_SECRET_ACCESS_KEY=<r2_secret_access_key>
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_BUCKET=<bucket_name>
R2_PUBLIC_URL=<public_url_for_files>

# Google Gemini API - sinh embedding cho tìm kiếm AI (model gemini-embedding-001)
GEMINI_API_KEY=<gemini_api_key>
